{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "rootDir": "..",
    "baseUrl": ".."
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "../src/model/**/*.ts", "../src/shared/**/*.ts", "../src/diff/types.ts"]
}
